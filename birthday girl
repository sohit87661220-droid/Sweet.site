<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Happy Birthday ❤️</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    min-height:100vh;
    font-family:Arial, sans-serif;
    background:linear-gradient(135deg,#ff4e8a,#8e44ad);
    display:flex;
    justify-content:center;
    align-items:center;
    overflow:hidden;
    color:white;
}

.container{
    width:90%;
    max-width:650px;
    text-align:center;
    padding:40px 25px;
    background:rgba(255,255,255,0.15);
    border:1px solid rgba(255,255,255,0.3);
    border-radius:30px;
    backdrop-filter:blur(12px);
    box-shadow:0 15px 40px rgba(0,0,0,0.3);
    z-index:10;
}

h1{
    font-size:48px;
    margin-bottom:15px;
    animation:glow 1.5s infinite alternate;
}

.name{
    font-size:38px;
    margin:15px 0;
    color:#fff;
}

.message{
    font-size:19px;
    line-height:1.7;
    margin:20px 0;
}

.gift{
    font-size:100px;
    cursor:pointer;
    animation:bounce 1.5s infinite;
    transition:0.3s;
}

.gift:hover{
    transform:scale(1.2);
}

button{
    border:none;
    padding:15px 30px;
    border-radius:30px;
    font-size:18px;
    font-weight:bold;
    background:white;
    color:#e84393;
    cursor:pointer;
    box-shadow:0 5px 15px rgba(0,0,0,0.2);
    transition:0.3s;
}

button:hover{
    transform:scale(1.08);
}

#surprise{
    display:none;
    margin-top:25px;
    animation:show 1s ease;
}

#surprise h2{
    font-size:32px;
    margin-bottom:15px;
}

.cake{
    font-size:90px;
    margin:15px;
}

.balloon{
    position:absolute;
    bottom:-100px;
    font-size:55px;
    animation:fly 8s linear infinite;
}

.balloon:nth-child(1){
    left:10%;
    animation-delay:0s;
}

.balloon:nth-child(2){
    left:30%;
    animation-delay:2s;
}

.balloon:nth-child(3){
    left:55%;
    animation-delay:4s;
}

.balloon:nth-child(4){
    left:80%;
    animation-delay:1s;
}

.heart{
    position:absolute;
    bottom:-50px;
    animation:heartFly 6s linear infinite;
    font-size:25px;
}

@keyframes glow{
    from{
        text-shadow:0 0 5px white;
    }
    to{
        text-shadow:0 0 30px white;
    }
}

@keyframes bounce{
    0%,100%{
        transform:translateY(0);
    }
    50%{
        transform:translateY(-15px);
    }
}

@keyframes show{
    from{
        opacity:0;
        transform:scale(0.5);
    }
    to{
        opacity:1;
        transform:scale(1);
    }
}

@keyframes fly{
    0%{
        bottom:-100px;
        transform:translateX(0) rotate(0);
    }
    100%{
        bottom:110vh;
        transform:translateX(80px) rotate(15deg);
    }
}

@keyframes heartFly{
    0%{
        bottom:-50px;
        opacity:1;
    }
    100%{
        bottom:110vh;
        opacity:0;
        transform:translateX(100px);
    }
}

@media(max-width:600px){
    h1{
        font-size:35px;
    }

    .name{
        font-size:28px;
    }

    .message{
        font-size:16px;
    }
}
</style>
</head>

<body>

<!-- Floating Balloons -->
<div class="balloon">🎈</div>
<div class="balloon">🎈</div>
<div class="balloon">🎈</div>
<div class="balloon">🎈</div>

<!-- Floating Hearts -->
<div class="heart" style="left:15%;animation-delay:1s;">❤️</div>
<div class="heart" style="left:40%;animation-delay:3s;">💖</div>
<div class="heart" style="left:70%;animation-delay:2s;">💕</div>
<div class="heart" style="left:90%;animation-delay:4s;">❤️</div>

<div class="container">

    <h1>🎂 Happy Birthday 🎂</h1>

    <!-- Yahan naam change karo -->
    <div class="name">
        Dear Special One ❤️
    </div>

    <div class="message">
        Today is your special day! 🥳<br>
        May your life always be filled with<br>
        happiness, love and beautiful memories. ✨
    </div>

    <div class="gift" onclick="openGift()">
        🎁
    </div>

    <p style="margin-bottom:15px;">
        Tap the gift to open your surprise 🎁
    </p>

    <button onclick="openGift()">
        💝 Open Your Surprise
    </button>

    <div id="surprise">

        <h2>🎉 SURPRISE! 🎉</h2>

        <div class="cake">
            🎂
        </div>

        <p class="message">
            You are a very special person. ❤️<br><br>

            I hope this birthday brings you<br>
            endless smiles, success and happiness. ✨<br><br>

            Keep smiling 😊<br>
            Keep shining ⭐<br>
            And always stay amazing! 💖
        </p>

        <h2>
            🥳 HAPPY BIRTHDAY 🥳
        </h2>

        <p style="margin-top:15px;">
            With lots of love ❤️
        </p>

    </div>

</div>

<script>

function openGift(){

    document.getElementById("surprise").style.display="block";

    // Confetti
    for(let i=0;i<60;i++){

        let confetti=document.createElement("div");

        confetti.innerHTML=["🎉","✨","💖","🎊","❤️","⭐"]
        [Math.floor(Math.random()*6)];

        confetti.style.position="fixed";
        confetti.style.left=Math.random()*100+"vw";
        confetti.style.top="-30px";
        confetti.style.fontSize=(15+Math.random()*25)+"px";
        confetti.style.zIndex="9999";
        confetti.style.pointerEvents="none";

        document.body.appendChild(confetti);

        let animation=confetti.animate(

            [
                {
                    transform:"translateY(0) rotate(0deg)",
                    opacity:1
                },
                {
                    transform:
                    "translateY(110vh) rotate(720deg)",
                    opacity:0
                }
            ],

            {
                duration:2000+Math.random()*3000,
                easing:"linear"
            }

        );

        animation.onfinish=()=>{
            confetti.remove();
        };
    }
}

</script>

</body>
</html>
